#!/usr/bin/env bash
# analyze-dumps — run every available model over the audio the server received.
#
#   analyze-dumps [DIR] [GLOB]
#
# The server keeps the audio of the last requests (VOXTYPE_GIGAAM_DUMP_DIR in
# the unit, default ~/.local/state/voxtype-stt/dumps). This script replays that
# audio through GigaAM (int8 and fp32) and Parakeet, printing mean token
# logprob and the text, so accuracy problems can be compared offline instead of
# guessed at. Higher mean logprob = the model is more confident in its output.

set -euo pipefail

DIR="${1:-$HOME/.local/state/voxtype-stt/dumps}"
GLOB="${2:-*.wav}"
VENV="$HOME/.local/share/voxtype-gigaam/.venv/bin/python"

[ -d "$DIR" ] || { echo "analyze-dumps: no such directory: $DIR" >&2; exit 1; }
mapfile -t FILES < <(ls -t "$DIR"/$GLOB 2>/dev/null || true)
[ "${#FILES[@]}" -gt 0 ] || { echo "analyze-dumps: no files matching $DIR/$GLOB" >&2; exit 1; }

HF_HUB_OFFLINE=1 "$VENV" - "${FILES[@]}" <<'PY'
import sys, time, wave
import numpy as np
import onnx_asr

MODELS = [
    ("gigaam-int8", {"model": "gigaam-v3-e2e-rnnt", "quantization": "int8"}),
    ("gigaam-fp32", {"model": "gigaam-v3-e2e-rnnt"}),
    ("parakeet-v3", {"model": "nemo-parakeet-tdt-0.6b-v3", "quantization": "int8"}),
]

loaded = []
for name, kwargs in MODELS:
    try:
        loaded.append((name, onnx_asr.load_model(providers=["CPUExecutionProvider"], **kwargs)))
    except Exception as exc:  # noqa: BLE001 - a missing model just gets skipped
        print(f"skipping {name}: {type(exc).__name__}: {exc}")

for path in sys.argv[1:]:
    with wave.open(path, "rb") as wav:
        rate = wav.getframerate()
        raw = wav.readframes(wav.getnframes())
    samples = np.frombuffer(raw, dtype="<i2").astype(np.float32) / 32768.0
    peak = float(np.abs(samples).max()) if samples.size else 0.0
    print(f"\n{path.split('/')[-1]}  {len(samples) / rate:.2f}s  peak={peak:.3f}")
    for name, model in loaded:
        started = time.monotonic()
        result = model.recognize(samples, sample_rate=rate)
        elapsed = time.monotonic() - started
        print(f"  {name:12s} {elapsed:5.2f}s  {result}")
PY
