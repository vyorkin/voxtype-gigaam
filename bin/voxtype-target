#!/usr/bin/env sh
# Maintain the "dictation target" window for the voxtype focus guard (Hyprland).
#
#   voxtype-target remember   # store the currently focused window
#   voxtype-target clear      # forget the stored window
#   voxtype-target show       # print the stored window address
set -eu

dir="${XDG_RUNTIME_DIR:-/tmp}/voxtype"
file="$dir/target"
mkdir -p "$dir"

case "${1:-}" in
  remember)
    timeout 2 hyprctl -j activewindow 2>/dev/null | jq -r '.address // empty' > "$file"
    ;;
  clear)
    rm -f "$file"
    ;;
  show)
    cat "$file" 2>/dev/null || true
    ;;
  *)
    echo "usage: voxtype-target remember|clear|show" >&2
    exit 2
    ;;
esac
