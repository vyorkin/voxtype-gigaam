#!/usr/bin/env bash
# voxtype-stt — switch voxtype's speech-to-text backend.
#
#   voxtype-stt gigaam    GigaAM v3 e2e (Russian, punctuation) via the local
#                         gigaam server and voxtype's remote mode + eager chunks
#   voxtype-stt whisper   the original local whisper.cpp setup
#   voxtype-stt status    show which backend is active and its health
#   voxtype-stt toggle    flip between the two
#
# The two profiles only differ in [whisper] config keys, so switching keeps
# every other setting (hotkey, output, OSD, focus-guard shim) untouched.
# Active profile is stored in $STATE_DIR/active and the whisper values that
# GigaAM overrides are saved to $STATE_DIR/whisper-previous.env so switching
# back restores exactly what was there before.

set -euo pipefail

ENDPOINT="${VOXTYPE_GIGAAM_ENDPOINT:-http://127.0.0.1:9017}"
GIGAAM_SOCKET="voxtype-gigaam.socket"
GIGAAM_SERVICE="voxtype-gigaam.service"
WHISPER_SERVICE="whisper-server.service"
VOXTYPE_SERVICE="voxtype.service"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/voxtype-stt"
PREVIOUS="$STATE_DIR/whisper-previous.env"
DEFAULT_WHISPER_MODEL="large-v3-turbo"

die() { printf 'voxtype-stt: %s\n' "$*" >&2; exit 1; }

config_get() { voxtype config get "$1" 2>/dev/null | head -1; }

set_config() {
  voxtype config set "$1" "$2" >/dev/null
  printf '  %-32s = %s\n' "$1" "$2"
}

save_whisper_settings() {
  mkdir -p "$STATE_DIR"
  if [ -f "$PREVIOUS" ]; then
    return 0
  fi
  cat >"$PREVIOUS" <<EOF
WHISPER_MODEL=$(config_get whisper.model)
WHISPER_EAGER=$(config_get whisper.eager_processing)
WHISPER_REMOTE_ENDPOINT=$(config_get whisper.remote_endpoint)
WHISPER_REMOTE_MODEL=$(config_get whisper.remote_model)
EOF
}

restore_whisper_settings() {
  local model="$DEFAULT_WHISPER_MODEL" eager="false" endpoint="null" remote_model="null"
  # shellcheck disable=SC1090
  [ -f "$PREVIOUS" ] && source "$PREVIOUS"
  model="${WHISPER_MODEL:-$DEFAULT_WHISPER_MODEL}"
  eager="${WHISPER_EAGER:-false}"
  endpoint="${WHISPER_REMOTE_ENDPOINT:-null}"
  remote_model="${WHISPER_REMOTE_MODEL:-null}"
  [ "$model" = "null" ] && model="$DEFAULT_WHISPER_MODEL"

  set_config whisper.mode local
  set_config whisper.model "$model"
  set_config whisper.eager_processing "$eager"
  if [ "$endpoint" != "null" ]; then
    set_config whisper.remote_endpoint "$endpoint"
  else
    voxtype config unset whisper.remote_endpoint >/dev/null
    printf '  %-32s = (unset)\n' whisper.remote_endpoint
  fi
  if [ "$remote_model" != "null" ]; then
    set_config whisper.remote_model "$remote_model"
  else
    voxtype config unset whisper.remote_model >/dev/null
    printf '  %-32s = (unset)\n' whisper.remote_model
  fi
}

wait_for_gigaam() {
  local deadline=$((SECONDS + 60))
  # The GET below is what trips socket activation; it blocks until the server
  # has loaded the model and answered, so a success means "ready to serve".
  while ! curl -sf "$ENDPOINT/health" >/dev/null 2>&1; do
    [ "$SECONDS" -ge "$deadline" ] && die "gigaam server did not become healthy in 60s; see: journalctl --user -u $GIGAAM_SERVICE -n 50"
    sleep 0.5
  done
}

switch_to_gigaam() {
  echo "Switching voxtype to GigaAM (remote mode, eager chunks):"
  save_whisper_settings
  systemctl --user enable --now "$GIGAAM_SOCKET" >/dev/null 2>&1 || systemctl --user start "$GIGAAM_SOCKET"
  # Long-running multilingual model for English and code-switched phrases.
  systemctl --user enable --now "$WHISPER_SERVICE" >/dev/null 2>&1 || systemctl --user start "$WHISPER_SERVICE"
  wait_for_gigaam
  printf '  %-32s = %s\n' "$GIGAAM_SERVICE" "$(systemctl --user is-active "$GIGAAM_SERVICE")"

  set_config engine whisper
  set_config whisper.mode remote
  set_config whisper.remote_endpoint "$ENDPOINT"
  # remote_model = auto: the server keeps Russian on GigaAM and sends English
  # and code-switched phrases (Latin words in Russian output, or output without
  # Cyrillic) to the local whisper.cpp server. See README in
  # ~/.local/share/voxtype-gigaam.
  set_config whisper.remote_model auto
  # eager_processing is deliberately off: voxtype's chunk boundary dedup
  # (src/eager.rs, deduplicate_boundary) compares words with
  # eq_ignore_ascii_case, which folds ASCII only. GigaAM returns Russian words
  # with capitals and punctuation, so a word straddling a 5s chunk boundary
  # never matches and gets typed twice. GigaAM is fast enough (~0.05x realtime)
  # that a single full-utterance decode costs less than the artefacts did.
  set_config whisper.eager_processing false

  systemctl --user restart "$VOXTYPE_SERVICE"
  echo "gigaam" >"$STATE_DIR/backend"
  echo "Done. Talk with the usual hotkey."
}

switch_to_whisper() {
  echo "Switching voxtype back to local whisper.cpp:"
  restore_whisper_settings

  systemctl --user restart "$VOXTYPE_SERVICE"
  systemctl --user stop "$GIGAAM_SERVICE" >/dev/null 2>&1 || true
  systemctl --user stop "$WHISPER_SERVICE" >/dev/null 2>&1 || true
  printf '  %-32s = %s\n' "$GIGAAM_SERVICE" "$(systemctl --user is-active "$GIGAAM_SERVICE")"
  printf '  %-32s = %s\n' "$WHISPER_SERVICE" "$(systemctl --user is-active "$WHISPER_SERVICE")"
  echo "whisper" >"$STATE_DIR/backend"
  echo "Done."
}

show_status() {
  local backend mode endpoint eager active_whisper active_gigaam health
  backend="$(cat "$STATE_DIR/backend" 2>/dev/null || echo unknown)"
  mode="$(config_get whisper.mode)"
  endpoint="$(config_get whisper.remote_endpoint)"
  eager="$(config_get whisper.eager_processing)"
  active_whisper="$(systemctl --user is-active "$VOXTYPE_SERVICE" 2>/dev/null || true)"
  active_gigaam="$(systemctl --user is-active "$GIGAAM_SERVICE" 2>/dev/null || true)"
  health="$(curl -sf --max-time 3 "$ENDPOINT/health" 2>/dev/null || echo unreachable)"

  printf 'backend (last switch) : %s\n' "$backend"
  printf 'engine                : %s\n' "$(config_get engine)"
  printf 'whisper.mode          : %s\n' "$mode"
  printf 'whisper.model         : %s\n' "$(config_get whisper.model)"
  printf 'whisper.eager_processing: %s\n' "$eager"
  printf 'whisper.remote_endpoint: %s\n' "$endpoint"
  printf 'whisper.remote_model  : %s\n' "$(config_get whisper.remote_model)"
  printf 'vad (enabled/backend/threshold): %s / %s / %s\n' \
    "$(config_get vad.enabled)" "$(config_get vad.backend)" "$(config_get vad.threshold)"
  printf '%-22s: %s\n' "$VOXTYPE_SERVICE" "$active_whisper"
  printf '%-22s: %s\n' "$GIGAAM_SERVICE" "$active_gigaam"
  printf '%-22s: %s\n' "$WHISPER_SERVICE" "$(systemctl --user is-active "$WHISPER_SERVICE" 2>/dev/null || true)"
  printf '%-22s: %s\n' "$GIGAAM_SOCKET" "$(systemctl --user is-active "$GIGAAM_SOCKET" 2>/dev/null || true)"
  printf 'gigaam endpoint       : %s\n' "$health"
}

case "${1:-status}" in
  gigaam) switch_to_gigaam ;;
  whisper) switch_to_whisper ;;
  status) show_status ;;
  toggle)
    current="$(cat "$STATE_DIR/backend" 2>/dev/null || echo whisper)"
    if [ "$current" = "gigaam" ]; then switch_to_whisper; else switch_to_gigaam; fi
    ;;
  *) die "usage: voxtype-stt {gigaam|whisper|status|toggle}" ;;
esac
