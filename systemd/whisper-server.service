[Unit]
Description=whisper.cpp server (large-v3-turbo, Vulkan) for voxtype code-switching
Documentation=file:%h/.local/share/voxtype-gigaam/README.md
After=graphical-session.target

[Service]
Type=simple
# Long-running multilingual model for the phrases GigaAM cannot do: pure
# English and English words inside Russian speech. The model is loaded once,
# so the gigaam server pays only the decode when it asks for a second opinion.
# Built from source with -DGGML_VULKAN=ON; see README ("Установка
# whisper-server"). The GGML model is the same file the local whisper profile
# of voxtype uses.
ExecStart=%h/.local/share/whisper.cpp/build/bin/whisper-server \
    -m %h/.local/share/voxtype/models/ggml-large-v3-turbo.bin \
    -l ru --host 127.0.0.1 --port 9018 -t 6
Restart=on-failure
RestartSec=3
# Dictation is interactive; do not let a busy machine starve the decoder.
Nice=-5

[Install]
WantedBy=graphical-session.target
